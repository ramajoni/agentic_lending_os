GROQ_API_KEY=your_groq_api_key_here

# Agent Config
MAX_ITERATIONS=5
CONFIDENCE_THRESHOLD=0.85
ALLOWLISTED_TOOLS=reverify_alternate_source,request_additional_document,query_historical_cases,check_fraud_watchlist,escalate_to_human,auto_clear
GROQ_MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct

# DAG Config
VERIFICATION_TIMEOUT_SECONDS=10
MAX_PARALLEL_CALLS=4

# Guardrail Config
PII_REDACTION_ENABLED=true
INJECTION_SCAN_ENABLED=true
PRESIDIO_ENABLED=true
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-22M
PROMPT_GUARD_THRESHOLD=0.5
HF_TOKEN=your_huggingface_token_here

# API Config
REQUEST_TIMEOUT_SECONDS=30
MAX_PAYLOAD_SIZE_KB=512

# Business Rules
NAME_MATCH_THRESHOLD=0.85
ADDRESS_MATCH_THRESHOLD=0.75
INCOME_MATERIALITY_THRESHOLD=0.20

# Service Authentication Tokens
PAN_SERVICE_TOKEN=pan_secure_token_2026
AADHAAR_SERVICE_TOKEN=aadhaar_secure_token_2026

